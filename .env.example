# 复制到后续应用项目根目录的 .env；此文件不包含真实密钥。
# 所有变量必须在 Settings 中声明并显式传给对应组件。
# 密钥和用户专属对话基础地址留空，模型选型已根据当前方案填写。

CHAT_PROVIDER=openai_compatible
CHAT_API_MODE=responses
CHAT_REASONING_EFFORT=low
CHAT_SEND_TEMPERATURE=false
# 【必填】在下一行等号后填写对话平台基础地址，不含 /responses 后缀。
CHAT_BASE_URL=
# 【必填/保密】在下一行等号后填写对话平台 API Key。
CHAT_API_KEY=
CHAT_MODEL=gpt-6-astra

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 【必填/保密】在下一行等号后填写硅基流动 API Key。
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Pro/BAAI/bge-m3
# 1024 是示例默认值，须与实际模型输出一致。
EMBEDDING_DIMENSIONS=1024
# 是否向向量 API 发送 dimensions 参数；BGE-M3 必须为 false。
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_BATCH_SIZE=10
EMBEDDING_ENCODING_FORMAT=float

APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
UI_HOST=127.0.0.1
UI_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

# 相对路径始终相对于应用项目根目录。
SOURCES_MANIFEST_PATH=./config/sources.manifest.json
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_PREFIX=patent_kb
CATALOG_DB_PATH=./data/sqlite/catalog.db
CHECKPOINT_DB_PATH=./data/sqlite/checkpoints.db
LOG_DIR=./data/logs
LOG_LEVEL=INFO
LOG_FULL_MODEL_PAYLOADS=false

CHAT_TEMPERATURE=0
CHAT_MAX_OUTPUT_TOKENS=2500
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2

CHUNK_TARGET_CHARS=700
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=100
RETRIEVAL_TOP_K=8
RETRIEVAL_PER_SOURCE_K=4
CONTEXT_MAX_CHUNKS=16
CONTEXT_MAX_CHARS=10000

MAX_RETRIEVAL_ROUNDS=2
MAX_TOOLS_PER_ROUND=2
MAX_CITATION_REPAIRS=1
GRAPH_RECURSION_LIMIT=30
RUN_TIMEOUT_SECONDS=180
APP_MAX_CONCURRENT_RUNS=1
CHAT_HISTORY_TURNS=4
QUESTION_MAX_CHARS=6000

# 可选，未选择云端 tracing 时保持关闭。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=patent-law-agent
LANGSMITH_ENDPOINT=

# 题目分析与教学方法（无新增密钥）
EXAM_ANALYSIS_ENABLED=true
TEACHING_METHODS_PATH=./data/teaching/methods
TEACHING_MAX_METHODS=2
TEACHING_CONTEXT_MAX_CHARS=3000
# 题目分析最多3轮检索（含首查），上限4；普通检索仍使用 MAX_RETRIEVAL_ROUNDS。
EXAM_MAX_RETRIEVAL_ROUNDS=3
EXAM_MAX_MODEL_CALLS=8
EXAM_MAX_OUTPUT_TOKENS=5000
EXAM_MAX_ANALYSIS_REPAIRS=1

# 补查前为最终分析和解释审核保留的时间（秒）；仍共用总时间与模型调用预算。
EXAM_COMPLETION_RESERVE_SECONDS=60
